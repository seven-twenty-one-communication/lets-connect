# ============================================================================
# CONNECTO (LetsConnect) — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values for local development.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=connecto_db
DB_USER=connecto_user
DB_PASS=connecto_secret_password
POSTGRES_PASSWORD=connecto_secret_password

# ----------------------------------------------------------------------------
# 2. CACHE & PUBSUB (Redis)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------------------------------------------------------------------
# 3. BACKEND SERVER & SECURITY (Spring Boot 3)
# ----------------------------------------------------------------------------
SERVER_PORT=8080
# Minimum 256-bit (32 character) secret for HS256 JWT signing
JWT_SECRET=connecto-super-secure-production-ready-jwt-secret-key-32chars
JWT_EXPIRATION_MS=2592000000

# ----------------------------------------------------------------------------
# 4. REAL-TIME AUDIO (Agora RTC)
# ----------------------------------------------------------------------------
# Required for token generation. Keep App Certificate server-side only!
AGORA_APP_ID=your-agora-app-id-here
AGORA_APP_CERTIFICATE=your-agora-app-certificate-here
AGORA_TOKEN_EXPIRATION_SECONDS=3600

# ----------------------------------------------------------------------------
# 5. PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# ----------------------------------------------------------------------------
FIREBASE_CONFIG_PATH=firebase-service-account.json

# ----------------------------------------------------------------------------
# 6. IN-APP PURCHASES & BILLING (Google Play)
# ----------------------------------------------------------------------------
GOOGLE_PLAY_PUBLIC_LICENSE_KEY=your-google-play-rsa-public-key

# ----------------------------------------------------------------------------
# 7. BUSINESS CONFIGURATION (Configurable, never hardcoded)
# ----------------------------------------------------------------------------
PLATFORM_COMMISSION_PERCENTAGE=40.0
LISTENER_DEFAULT_RATE_COINS=10

# ----------------------------------------------------------------------------
# 8. MOBILE CLIENT (React Native)
# ----------------------------------------------------------------------------
# For Android emulator pointing to local host: http://10.0.2.2:8080/api/v1
# For physical device: http://<YOUR_LAN_IP>:8080/api/v1
REACT_APP_API_BASE_URL=http://10.0.2.2:8080/api/v1

# ----------------------------------------------------------------------------
# 9. ADMIN DASHBOARD (Next.js)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
